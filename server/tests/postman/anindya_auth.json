{
  "info": {
    "_postman_id": "d5e6f7a8-b9c0-4d1e-8f2a-3b4c5d6e7f8a",
    "name": "Anindya Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "anindya"
  },
  "item": [
    {
      "name": "Register - POST /api/anindya/auth/register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts = Date.now();",
              "const rand = Math.floor(Math.random()*100000);",
              "const base = ts + \"_\" + rand;",
              "const username = \"Anindya_\" + base;",
              "const email = \"Anindya_\" + base + \"@Example.COM\";",
              "const password = \"Password123!\";",
              "pm.collectionVariables.set(\"testUsername\", username);",
              "pm.collectionVariables.set(\"testEmail\", email);",
              "pm.collectionVariables.set(\"testPassword\", password);",
              "pm.collectionVariables.set(\"testUsernameLower\", username.toLowerCase());",
              "pm.collectionVariables.set(\"testEmailLower\", email.toLowerCase());",
              "console.log(\"Generated test user:\", username, email);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Content-Type is application/json\", function () { pm.response.to.have.header(\"content-type\", \"application/json\"); });",
              "pm.test(\"Response has success message and user + token\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql(\"User registered successfully\");",
              "    pm.expect(json).to.have.property(\"user\");",
              "    pm.expect(json).to.have.property(\"token\").that.is.a(\"string\").and.not.empty;",
              "    const user = json.user;",
              "    pm.expect(user).to.have.property(\"id\").that.is.a(\"number\");",
              "    pm.expect(user.username).to.eql(pm.collectionVariables.get(\"testUsername\"));",
              "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"testEmail\"));",
              "    pm.expect(user).to.have.property(\"created_at\");",
              "    pm.expect(user).to.have.property(\"updated_at\");",
              "    pm.expect(user).to.not.have.property(\"password\");",
              "});",
              "pm.test(\"Save token for later\", function () {",
              "    const json = pm.response.json();",
              "    if (json.token) pm.collectionVariables.set(\"authToken\", json.token);",
              "    if (json.user && json.user.id) pm.collectionVariables.set(\"userId\", json.user.id);",
              "});",
              "",
              "// --- Additional Register Tests via pm.sendRequest (keeps 3-request collection but preserves coverage) ---",
              "",
              "// Duplicate Email (409)",
              "pm.sendRequest({",
              "    url: 'http://localhost:5000/api/anindya/auth/register',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify({ username: \"Anindya_Dup_\" + Math.floor(Math.random()*100000), email: pm.collectionVariables.get(\"testEmail\"), password: pm.collectionVariables.get(\"testPassword\") }) }",
              "}, function (err, res) {",
              "    pm.test(\"Register Duplicate Email - Status code is 409 Conflict\", function () { pm.expect(res.code).to.eql(409); });",
              "    pm.test(\"Register Duplicate Email - Error code 219\", function () {",
              "        const json = res.json();",
              "        pm.expect(json.errCode).to.eql(219);",
              "        pm.expect(json.errMsg).to.eql(\"Email already registered\");",
              "    });",
              "    // Duplicate Username (409)",
              "    pm.sendRequest({",
              "        url: 'http://localhost:5000/api/anindya/auth/register',",
              "        method: 'POST',",
              "        header: { 'Content-Type': 'application/json' },",
              "        body: { mode: 'raw', raw: JSON.stringify({ username: pm.collectionVariables.get(\"testUsername\"), email: \"alt_\" + Date.now() + \"_\" + Math.floor(Math.random()*10000) + \"@example.com\", password: pm.collectionVariables.get(\"testPassword\") }) }",
              "    }, function (err, res) {",
              "        pm.test(\"Register Duplicate Username - Status code is 409 Conflict\", function () { pm.expect(res.code).to.eql(409); });",
              "        pm.test(\"Register Duplicate Username - Error code 220\", function () {",
              "            const json = res.json();",
              "            pm.expect(json.errCode).to.eql(220);",
              "            pm.expect(json.errMsg).to.eql(\"Username already taken\");",
              "        });",
              "        // Case-Sensitive Distinct Username (201) - uses separate caseUsername pair to avoid colliding with login wrong-case test",
              "        const caseBase = Date.now() + \"_\" + Math.floor(Math.random()*10000);",
              "        const caseUsername = \"CaseUser_\" + caseBase + \"_A\";",
              "        const caseUsernameLower = caseUsername.toLowerCase();",
              "        const caseEmailForUser = \"caseuser_\" + caseBase + \"_a1@example.com\";",
              "        const caseEmailForLower = \"caseuser_\" + caseBase + \"_a2@example.com\";",
              "        pm.collectionVariables.set(\"caseUsername\", caseUsername);",
              "        pm.collectionVariables.set(\"caseUsernameLower\", caseUsernameLower);",
              "        // First register the mixed-case username",
              "        pm.sendRequest({",
              "            url: 'http://localhost:5000/api/anindya/auth/register',",
              "            method: 'POST',",
              "            header: { 'Content-Type': 'application/json' },",
              "            body: { mode: 'raw', raw: JSON.stringify({ username: caseUsername, email: caseEmailForUser, password: pm.collectionVariables.get(\"testPassword\") }) }",
              "        }, function (err, res) {",
              "            pm.test(\"Register Case-Sensitive Username - First mixed-case user 201\", function () { pm.expect(res.code).to.eql(201); });",
              "            // Then register lowercased variant with different email - should also succeed if case-sensitive",
              "            pm.sendRequest({",
              "                url: 'http://localhost:5000/api/anindya/auth/register',",
              "                method: 'POST',",
              "                header: { 'Content-Type': 'application/json' },",
              "                body: { mode: 'raw', raw: JSON.stringify({ username: caseUsernameLower, email: caseEmailForLower, password: pm.collectionVariables.get(\"testPassword\") }) }",
              "            }, function (err, res) {",
              "                pm.test(\"Register Case-Sensitive Distinct Username - Status code is 201\", function () { pm.expect(res.code).to.eql(201); });",
              "                pm.test(\"Register Case-Sensitive Distinct Username - stored lowercased value\", function () {",
              "                    const json = res.json();",
              "                    pm.expect(json.user.username).to.eql(caseUsernameLower);",
              "                });",
              "                // Case-Sensitive Distinct Email (201) - separate pair",
              "                const emailBase = Date.now() + \"_\" + Math.floor(Math.random()*10000);",
              "                const caseEmail = \"CaseEmail_\" + emailBase + \"@Example.COM\";",
              "                const caseEmailLower = caseEmail.toLowerCase();",
              "                const caseUserForEmail = \"CaseEmailUser_\" + emailBase + \"_A\";",
              "                const caseUserForLower = \"CaseEmailUser_\" + emailBase + \"_B\";",
              "                pm.collectionVariables.set(\"caseEmail\", caseEmail);",
              "                pm.collectionVariables.set(\"caseEmailLower\", caseEmailLower);",
              "                pm.sendRequest({",
              "                    url: 'http://localhost:5000/api/anindya/auth/register',",
              "                    method: 'POST',",
              "                    header: { 'Content-Type': 'application/json' },",
              "                    body: { mode: 'raw', raw: JSON.stringify({ username: caseUserForEmail, email: caseEmail, password: pm.collectionVariables.get(\"testPassword\") }) }",
              "                }, function (err, res) {",
              "                    pm.test(\"Register Case-Sensitive Email - First mixed-case email 201\", function () { pm.expect(res.code).to.eql(201); });",
              "                    pm.sendRequest({",
              "                        url: 'http://localhost:5000/api/anindya/auth/register',",
              "                        method: 'POST',",
              "                        header: { 'Content-Type': 'application/json' },",
              "                        body: { mode: 'raw', raw: JSON.stringify({ username: caseUserForLower, email: caseEmailLower, password: pm.collectionVariables.get(\"testPassword\") }) }",
              "                    }, function (err, res) {",
              "                        pm.test(\"Register Case-Sensitive Distinct Email - Status code is 201\", function () { pm.expect(res.code).to.eql(201); });",
              "                        pm.test(\"Register Case-Sensitive Distinct Email - stored lowercased value\", function () {",
              "                            const json = res.json();",
              "                            pm.expect(json.user.email).to.eql(caseEmailLower);",
              "                        });",
              "                        // Missing Username (400)",
              "                        pm.sendRequest({",
              "                            url: 'http://localhost:5000/api/anindya/auth/register',",
              "                            method: 'POST',",
              "                            header: { 'Content-Type': 'application/json' },",
              "                            body: { mode: 'raw', raw: JSON.stringify({ email: \"missinguser_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"Password123!\" }) }",
              "                        }, function (err, res) {",
              "                            pm.test(\"Register Missing Username - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                            pm.test(\"Register Missing Username - Error code 211\", function () {",
              "                                const json = res.json();",
              "                                pm.expect(json.errCode).to.eql(211);",
              "                            });",
              "                            // Username Too Short (400)",
              "                            pm.sendRequest({",
              "                                url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                method: 'POST',",
              "                                header: { 'Content-Type': 'application/json' },",
              "                                body: { mode: 'raw', raw: JSON.stringify({ username: \"ab\", email: \"shortuser_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"Password123!\" }) }",
              "                            }, function (err, res) {",
              "                                pm.test(\"Register Username Too Short - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                                pm.test(\"Register Username Too Short - Error code 212\", function () {",
              "                                    const json = res.json();",
              "                                    pm.expect(json.errCode).to.eql(212);",
              "                                });",
              "                                // Missing Email (400)",
              "                                pm.sendRequest({",
              "                                    url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                    method: 'POST',",
              "                                    header: { 'Content-Type': 'application/json' },",
              "                                    body: { mode: 'raw', raw: JSON.stringify({ username: \"user_missing_email_\" + Math.floor(Math.random()*100000), password: \"Password123!\" }) }",
              "                                }, function (err, res) {",
              "                                    pm.test(\"Register Missing Email - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                                    pm.test(\"Register Missing Email - Error code 214\", function () {",
              "                                        const json = res.json();",
              "                                        pm.expect(json.errCode).to.eql(214);",
              "                                    });",
              "                                    // Invalid Email Format (400)",
              "                                    pm.sendRequest({",
              "                                        url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                        method: 'POST',",
              "                                        header: { 'Content-Type': 'application/json' },",
              "                                        body: { mode: 'raw', raw: JSON.stringify({ username: \"user_invalid_email_\" + Math.floor(Math.random()*100000), email: \"not-an-email\", password: \"Password123!\" }) }",
              "                                    }, function (err, res) {",
              "                                        pm.test(\"Register Invalid Email - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                                        pm.test(\"Register Invalid Email - Error code 215\", function () {",
              "                                            const json = res.json();",
              "                                            pm.expect(json.errCode).to.eql(215);",
              "                                        });",
              "                                        // Missing Password (400)",
              "                                        pm.sendRequest({",
              "                                            url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                            method: 'POST',",
              "                                            header: { 'Content-Type': 'application/json' },",
              "                                            body: { mode: 'raw', raw: JSON.stringify({ username: \"user_nopass_\" + Math.floor(Math.random()*100000), email: \"nopass_\" + Math.floor(Math.random()*100000) + \"@example.com\" }) }",
              "                                        }, function (err, res) {",
              "                                            pm.test(\"Register Missing Password - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                                            pm.test(\"Register Missing Password - Error code 216\", function () {",
              "                                                const json = res.json();",
              "                                                pm.expect(json.errCode).to.eql(216);",
              "                                            });",
              "                                            // Short Password (400)",
              "                                            pm.sendRequest({",
              "                                                url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                                method: 'POST',",
              "                                                header: { 'Content-Type': 'application/json' },",
              "                                                body: { mode: 'raw', raw: JSON.stringify({ username: \"user_shortpass_\" + Math.floor(Math.random()*100000), email: \"shortpass_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"123\" }) }",
              "                                            }, function (err, res) {",
              "                                                pm.test(\"Register Short Password - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                                                pm.test(\"Register Short Password - Error code 217\", function () {",
              "                                                    const json = res.json();",
              "                                                    pm.expect(json.errCode).to.eql(217);",
              "                                                });",
              "                                            });",
              "                                        });",
              "                                    });",
              "                                });",
              "                            });",
              "                        });",
              "                    });",
              "                });",
              "            });",
              "        });",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5000/api/anindya/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "anindya", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "Login - POST /api/anindya/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login - Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Login - Response has Login successful message\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql(\"Login successful\");",
              "    pm.expect(json).to.have.property(\"user\");",
              "    pm.expect(json).to.have.property(\"token\").that.is.a(\"string\").and.not.empty;",
              "    pm.expect(json.user.email).to.eql(pm.collectionVariables.get(\"testEmail\"));",
              "    pm.expect(json.user.username).to.eql(pm.collectionVariables.get(\"testUsername\"));",
              "    pm.expect(json.user).to.not.have.property(\"password\");",
              "});",
              "pm.test(\"Login - Save token\", function () {",
              "    const json = pm.response.json();",
              "    if (json.token) pm.collectionVariables.set(\"authToken\", json.token);",
              "    if (json.user && json.user.id) pm.collectionVariables.set(\"userId\", json.user.id);",
              "});",
              "",
              "// --- Additional Login Tests ---",
              "// Success with Username",
              "pm.sendRequest({",
              "    url: 'http://localhost:5000/api/anindya/auth/login',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify({ username: pm.collectionVariables.get(\"testUsername\"), password: pm.collectionVariables.get(\"testPassword\") }) }",
              "}, function (err, res) {",
              "    pm.test(\"Login Success with Username - Status code is 200\", function () { pm.expect(res.code).to.eql(200); });",
              "    pm.test(\"Login Success with Username - correct user\", function () {",
              "        const json = res.json();",
              "        pm.expect(json.message).to.eql(\"Login successful\");",
              "        pm.expect(json.user.username).to.eql(pm.collectionVariables.get(\"testUsername\"));",
              "    });",
              "    // Success with Identifier Field",
              "    pm.sendRequest({",
              "        url: 'http://localhost:5000/api/anindya/auth/login',",
              "        method: 'POST',",
              "        header: { 'Content-Type': 'application/json' },",
              "        body: { mode: 'raw', raw: JSON.stringify({ identifier: pm.collectionVariables.get(\"testEmail\"), password: pm.collectionVariables.get(\"testPassword\") }) }",
              "    }, function (err, res) {",
              "        pm.test(\"Login Success with Identifier - Status code is 200\", function () { pm.expect(res.code).to.eql(200); });",
              "        pm.test(\"Login Success with Identifier - has token\", function () {",
              "            const json = res.json();",
              "            pm.expect(json).to.have.property(\"token\");",
              "        });",
              "        // Wrong Case Username (401)",
              "        pm.sendRequest({",
              "            url: 'http://localhost:5000/api/anindya/auth/login',",
              "            method: 'POST',",
              "            header: { 'Content-Type': 'application/json' },",
              "            body: { mode: 'raw', raw: JSON.stringify({ username: pm.collectionVariables.get(\"testUsernameLower\"), password: pm.collectionVariables.get(\"testPassword\") }) }",
              "        }, function (err, res) {",
              "            pm.test(\"Login Wrong Case Username - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "            pm.test(\"Login Wrong Case Username - Error code 233\", function () {",
              "                const json = res.json();",
              "                pm.expect(json.errCode).to.eql(233);",
              "            });",
              "            // Wrong Case Email (401)",
              "            pm.sendRequest({",
              "                url: 'http://localhost:5000/api/anindya/auth/login',",
              "                method: 'POST',",
              "                header: { 'Content-Type': 'application/json' },",
              "                body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get(\"testEmailLower\"), password: pm.collectionVariables.get(\"testPassword\") }) }",
              "            }, function (err, res) {",
              "                pm.test(\"Login Wrong Case Email - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "                pm.test(\"Login Wrong Case Email - Error code 233\", function () {",
              "                    const json = res.json();",
              "                    pm.expect(json.errCode).to.eql(233);",
              "                });",
              "                // Wrong Password (401)",
              "                pm.sendRequest({",
              "                    url: 'http://localhost:5000/api/anindya/auth/login',",
              "                    method: 'POST',",
              "                    header: { 'Content-Type': 'application/json' },",
              "                    body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get(\"testEmail\"), password: \"WrongPassword123!\" }) }",
              "                }, function (err, res) {",
              "                    pm.test(\"Login Wrong Password - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "                    pm.test(\"Login Wrong Password - Error code 233\", function () {",
              "                        const json = res.json();",
              "                        pm.expect(json.errCode).to.eql(233);",
              "                    });",
              "                    // Missing Identifier (400)",
              "                    pm.sendRequest({",
              "                        url: 'http://localhost:5000/api/anindya/auth/login',",
              "                        method: 'POST',",
              "                        header: { 'Content-Type': 'application/json' },",
              "                        body: { mode: 'raw', raw: JSON.stringify({ password: pm.collectionVariables.get(\"testPassword\") }) }",
              "                    }, function (err, res) {",
              "                        pm.test(\"Login Missing Identifier - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                        pm.test(\"Login Missing Identifier - Error code 231\", function () {",
              "                            const json = res.json();",
              "                            pm.expect(json.errCode).to.eql(231);",
              "                        });",
              "                        // Missing Password (400)",
              "                        pm.sendRequest({",
              "                            url: 'http://localhost:5000/api/anindya/auth/login',",
              "                            method: 'POST',",
              "                            header: { 'Content-Type': 'application/json' },",
              "                            body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get(\"testEmail\") }) }",
              "                        }, function (err, res) {",
              "                            pm.test(\"Login Missing Password - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                            pm.test(\"Login Missing Password - Error code 232\", function () {",
              "                                const json = res.json();",
              "                                pm.expect(json.errCode).to.eql(232);",
              "                            });",
              "                            // Non-existent User (401)",
              "                            pm.sendRequest({",
              "                                url: 'http://localhost:5000/api/anindya/auth/login',",
              "                                method: 'POST',",
              "                                header: { 'Content-Type': 'application/json' },",
              "                                body: { mode: 'raw', raw: JSON.stringify({ email: \"nonexistent_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"Password123!\" }) }",
              "                            }, function (err, res) {",
              "                                pm.test(\"Login Non-existent User - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "                                pm.test(\"Login Non-existent User - Error code 233\", function () {",
              "                                    const json = res.json();",
              "                                    pm.expect(json.errCode).to.eql(233);",
              "                                });",
              "                            });",
              "                        });",
              "                    });",
              "                });",
              "            });",
              "        });",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5000/api/anindya/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "anindya", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "Me - GET /api/anindya/auth/me",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Me - Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Me - Response has user object\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"user\");",
              "    const user = json.user;",
              "    pm.expect(user).to.have.property(\"id\");",
              "    pm.expect(user.username).to.eql(pm.collectionVariables.get(\"testUsername\"));",
              "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"testEmail\"));",
              "    pm.expect(user).to.have.property(\"created_at\");",
              "    pm.expect(user).to.have.property(\"updated_at\");",
              "    pm.expect(user).to.not.have.property(\"password\");",
              "});",
              "pm.test(\"Me - User id matches expected\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.user.id).to.eql(parseInt(pm.collectionVariables.get(\"userId\")));",
              "});",
              "",
              "// --- Additional Me Tests ---",
              "// Missing Token (401)",
              "pm.sendRequest({",
              "    url: 'http://localhost:5000/api/anindya/auth/me',",
              "    method: 'GET'",
              "}, function (err, res) {",
              "    pm.test(\"Me Missing Token - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "    pm.test(\"Me Missing Token - Error code 200\", function () {",
              "        const json = res.json();",
              "        pm.expect(json.errCode).to.eql(200);",
              "    });",
              "    // Invalid Token (401)",
              "    pm.sendRequest({",
              "        url: 'http://localhost:5000/api/anindya/auth/me',",
              "        method: 'GET',",
              "        header: { 'Authorization': 'Bearer invalid.token.here' }",
              "    }, function (err, res) {",
              "        pm.test(\"Me Invalid Token - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "        pm.test(\"Me Invalid Token - Error code 201\", function () {",
              "            const json = res.json();",
              "            pm.expect(json.errCode).to.eql(201);",
              "        });",
              "        // Malformed Authorization Header - No Bearer Prefix (401)",
              "        pm.sendRequest({",
              "            url: 'http://localhost:5000/api/anindya/auth/me',",
              "            method: 'GET',",
              "            header: { 'Authorization': pm.collectionVariables.get(\"authToken\") }",
              "        }, function (err, res) {",
              "            pm.test(\"Me Malformed Header - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "            pm.test(\"Me Malformed Header - Error code 200\", function () {",
              "                const json = res.json();",
              "                pm.expect(json.errCode).to.eql(200);",
              "            });",
              "            // Empty Bearer Token (401)",
              "            pm.sendRequest({",
              "                url: 'http://localhost:5000/api/anindya/auth/me',",
              "                method: 'GET',",
              "                header: { 'Authorization': 'Bearer ' }",
              "            }, function (err, res) {",
              "                pm.test(\"Me Empty Bearer - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "                pm.test(\"Me Empty Bearer - Error code 200\", function () {",
              "                    const json = res.json();",
              "                    pm.expect(json.errCode).to.eql(200);",
              "                });",
              "            });",
              "        });",
              "    });",
              "});"
            ]
          }
        }
