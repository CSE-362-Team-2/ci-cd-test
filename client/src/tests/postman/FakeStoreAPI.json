    {
      "name": "Get cart info (HTTP GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Cart should have id field of type integer\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData[0].id).to.not.eq(null);",
              "    pm.expect(jsonData[0].id).to.not.eq(undefined);",
              "    pm.expect(typeof jsonData[0].id).to.eq(\"number\");",
              "    pm.expect(Number.isInteger(jsonData[0].id)).to.be.true;",
              "});",
              "",
              "pm.test(\"Cart should have userId field of type integer\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData[0].userId).to.not.eq(null);",
              "    pm.expect(jsonData[0].userId).to.not.eq(undefined);",
              "    pm.expect(typeof jsonData[0].userId).to.eq(\"number\");",
              "    pm.expect(Number.isInteger(jsonData[0].userId)).to.be.true;",
              "});",
              "",
              "pm.test(\"Cart should have date field of type string\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData[0].date).to.not.eq(null);",
              "    pm.expect(jsonData[0].date).to.not.eq(undefined);",
              "    pm.expect(typeof jsonData[0].date).to.eq(\"string\");",
              "});",
              "",
              "pm.test(\"Cart should have products field of type array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData[0].products).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Cart should have __v field of type integer\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData[0].__v).to.not.eq(null);",
              "    pm.expect(jsonData[0].__v).to.not.eq(undefined);",
              "    pm.expect(typeof jsonData[0].__v).to.eq(\"number\");",
              "    pm.expect(Number.isInteger(jsonData[0].__v)).to.be.true;",
              "});",
              "",
              "pm.test(\"Product productId field should be integer\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(typeof jsonData[0].products[0].productId).to.eq(\"number\");",
              "    pm.expect(Number.isInteger(jsonData[0].products[0].productId)).to.be.true;",
              "});",
              "",
              "pm.test(\"Product quantity field should be integer\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(typeof jsonData[0].products[0].quantity).to.eq(\"number\");",
              "    pm.expect(Number.isInteger(jsonData[0].products[0].quantity)).to.be.true;",
              "});"
            ],
