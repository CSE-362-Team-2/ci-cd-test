  },
  "item": [
    {
      "name": "Register - POST /api/anindya/auth/register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts = Date.now();",
              "const rand = Math.floor(Math.random()*100000);",
              "const base = ts + \"_\" + rand;",
              "pm.collectionVariables.set(\"testName\", \"Anindya_\" + base);",
              "pm.collectionVariables.set(\"testEmail\", \"Anindya_\" + base + \"@Example.COM\");",
              "pm.collectionVariables.set(\"testPassword\", \"Password123!\");",
              "pm.collectionVariables.set(\"testRole\", \"user\");",
              "pm.collectionVariables.set(\"testEmailLower\", (\"Anindya_\" + base + \"@Example.COM\").toLowerCase());",
              "pm.collectionVariables.set(\"adminName\", \"Admin_\" + base);",
              "pm.collectionVariables.set(\"adminEmail\", \"Admin_\" + base + \"@Example.COM\");",
              "pm.collectionVariables.set(\"adminPassword\", \"AdminPass123!\");",
              "pm.collectionVariables.set(\"adminRole\", \"admin\");",
              "console.log(\"Generated test user:\", pm.collectionVariables.get(\"testName\"), pm.collectionVariables.get(\"testEmail\"));",
              "console.log(\"Generated admin user:\", pm.collectionVariables.get(\"adminName\"), pm.collectionVariables.get(\"adminEmail\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Register - Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Register - Content-Type is application/json\", function () { pm.response.to.have.header(\"content-type\", \"application/json\"); });",
              "pm.test(\"Register - Response has success message and user + token\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql(\"User registered successfully\");",
              "    pm.expect(json).to.have.property(\"user\");",
              "    pm.expect(json).to.have.property(\"token\").that.is.a(\"string\").and.not.empty;",
              "    const user = json.user;",
              "    pm.expect(user).to.have.property(\"id\").that.is.a(\"number\");",
              "    pm.expect(user.name).to.eql(pm.collectionVariables.get(\"testName\"));",
              "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"testEmail\"));",
              "    pm.expect(user.role).to.eql(\"user\");",
              "    pm.expect(user).to.have.property(\"created_at\");",
              "    pm.expect(user).to.have.property(\"updated_at\");",
              "    pm.expect(user).to.not.have.property(\"password\");",
              "});",
              "pm.test(\"Register - Save token and userId\", function () {",
              "    const json = pm.response.json();",
              "    if (json.token) pm.collectionVariables.set(\"authToken\", json.token);",
              "    if (json.user && json.user.id) pm.collectionVariables.set(\"userId\", json.user.id);",
              "});",
              "",
              "// --- Additional Register Tests ---",
              "// Duplicate Email (409) - same email, different name",
              "pm.sendRequest({",
              "    url: 'http://localhost:5000/api/anindya/auth/register',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify({ name: \"Anindya_Dup_\" + Math.floor(Math.random()*100000), email: pm.collectionVariables.get(\"testEmail\"), password: pm.collectionVariables.get(\"testPassword\"), role: \"user\" }) }",
              "}, function (err, res) {",
              "    pm.test(\"Register Duplicate Email - Status code is 409 Conflict\", function () { pm.expect(res.code).to.eql(409); });",
              "    pm.test(\"Register Duplicate Email - Error code 219\", function () {",
              "        const json = res.json();",
              "        pm.expect(json.errCode).to.eql(219);",
              "        pm.expect(json.errMsg).to.eql(\"Email already registered\");",
              "    });",
              "    // Case-Sensitive Distinct Email (201) - separate pair to avoid colliding with login wrong-case test",
              "    const emailBase = Date.now() + \"_\" + Math.floor(Math.random()*10000);",
              "    const caseEmail = \"CaseEmail_\" + emailBase + \"@Example.COM\";",
              "    const caseEmailLower = caseEmail.toLowerCase();",
              "    const caseUserForEmail = \"CaseEmailUser_\" + emailBase + \"_A\";",
              "    const caseUserForLower = \"CaseEmailUser_\" + emailBase + \"_B\";",
              "    pm.sendRequest({",
              "        url: 'http://localhost:5000/api/anindya/auth/register',",
              "        method: 'POST',",
              "        header: { 'Content-Type': 'application/json' },",
              "        body: { mode: 'raw', raw: JSON.stringify({ name: caseUserForEmail, email: caseEmail, password: pm.collectionVariables.get(\"testPassword\"), role: \"user\" }) }",
              "    }, function (err, res) {",
              "        pm.test(\"Register Case-Sensitive Email - First mixed-case email 201\", function () { pm.expect(res.code).to.eql(201); });",
              "        pm.sendRequest({",
              "            url: 'http://localhost:5000/api/anindya/auth/register',",
              "            method: 'POST',",
              "            header: { 'Content-Type': 'application/json' },",
              "            body: { mode: 'raw', raw: JSON.stringify({ name: caseUserForLower, email: caseEmailLower, password: pm.collectionVariables.get(\"testPassword\"), role: \"user\" }) }",
              "        }, function (err, res) {",
              "            pm.test(\"Register Case-Sensitive Distinct Email - Status code is 201\", function () { pm.expect(res.code).to.eql(201); });",
              "            pm.test(\"Register Case-Sensitive Distinct Email - stored lowercased email\", function () {",
              "                const json = res.json();",
              "                pm.expect(json.user.email).to.eql(caseEmailLower);",
              "            });",
              "            // Missing Name (400)",
              "            pm.sendRequest({",
              "                url: 'http://localhost:5000/api/anindya/auth/register',",
              "                method: 'POST',",
              "                header: { 'Content-Type': 'application/json' },",
              "                body: { mode: 'raw', raw: JSON.stringify({ email: \"noname_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"Password123!\", role: \"user\" }) }",
              "            }, function (err, res) {",
              "                pm.test(\"Register Missing Name - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                pm.test(\"Register Missing Name - Error code 211\", function () {",
              "                    const json = res.json();",
              "                    pm.expect(json.errCode).to.eql(211);",
              "                });",
              "                // Name Too Short (400)",
              "                pm.sendRequest({",
              "                    url: 'http://localhost:5000/api/anindya/auth/register',",
              "                    method: 'POST',",
              "                    header: { 'Content-Type': 'application/json' },",
              "                    body: { mode: 'raw', raw: JSON.stringify({ name: \"ab\", email: \"shortname_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"Password123!\", role: \"user\" }) }",
              "                }, function (err, res) {",
              "                    pm.test(\"Register Name Too Short - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                    pm.test(\"Register Name Too Short - Error code 212\", function () {",
              "                        const json = res.json();",
              "                        pm.expect(json.errCode).to.eql(212);",
              "                    });",
              "                    // Missing Email (400)",
              "                    pm.sendRequest({",
              "                        url: 'http://localhost:5000/api/anindya/auth/register',",
              "                        method: 'POST',",
              "                        header: { 'Content-Type': 'application/json' },",
              "                        body: { mode: 'raw', raw: JSON.stringify({ name: \"user_missing_email_\" + Math.floor(Math.random()*100000), password: \"Password123!\", role: \"user\" }) }",
              "                    }, function (err, res) {",
              "                        pm.test(\"Register Missing Email - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                        pm.test(\"Register Missing Email - Error code 214\", function () {",
              "                            const json = res.json();",
              "                            pm.expect(json.errCode).to.eql(214);",
              "                        });",
              "                        // Invalid Email Format (400)",
              "                        pm.sendRequest({",
              "                            url: 'http://localhost:5000/api/anindya/auth/register',",
              "                            method: 'POST',",
              "                            header: { 'Content-Type': 'application/json' },",
              "                            body: { mode: 'raw', raw: JSON.stringify({ name: \"user_invalid_email_\" + Math.floor(Math.random()*100000), email: \"not-an-email\", password: \"Password123!\", role: \"user\" }) }",
              "                        }, function (err, res) {",
              "                            pm.test(\"Register Invalid Email - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                            pm.test(\"Register Invalid Email - Error code 215\", function () {",
              "                                const json = res.json();",
              "                                pm.expect(json.errCode).to.eql(215);",
              "                            });",
              "                            // Missing Password (400)",
              "                            pm.sendRequest({",
              "                                url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                method: 'POST',",
              "                                header: { 'Content-Type': 'application/json' },",
              "                                body: { mode: 'raw', raw: JSON.stringify({ name: \"user_nopass_\" + Math.floor(Math.random()*100000), email: \"nopass_\" + Math.floor(Math.random()*100000) + \"@example.com\", role: \"user\" }) }",
              "                            }, function (err, res) {",
              "                                pm.test(\"Register Missing Password - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                                pm.test(\"Register Missing Password - Error code 216\", function () {",
              "                                    const json = res.json();",
              "                                    pm.expect(json.errCode).to.eql(216);",
              "                                });",
              "                                // Short Password (400)",
              "                                pm.sendRequest({",
              "                                    url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                    method: 'POST',",
              "                                    header: { 'Content-Type': 'application/json' },",
              "                                    body: { mode: 'raw', raw: JSON.stringify({ name: \"user_shortpass_\" + Math.floor(Math.random()*100000), email: \"shortpass_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"123\", role: \"user\" }) }",
              "                                }, function (err, res) {",
              "                                    pm.test(\"Register Short Password - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                                    pm.test(\"Register Short Password - Error code 217\", function () {",
              "                                        const json = res.json();",
              "                                        pm.expect(json.errCode).to.eql(217);",
              "                                    });",
              "                                    // Invalid Role (400)",
              "                                    pm.sendRequest({",
              "                                        url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                        method: 'POST',",
              "                                        header: { 'Content-Type': 'application/json' },",
              "                                        body: { mode: 'raw', raw: JSON.stringify({ name: \"user_invalid_role_\" + Math.floor(Math.random()*100000), email: \"invalidrole_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"Password123!\", role: \"superuser\" }) }",
              "                                    }, function (err, res) {",
              "                                        pm.test(\"Register Invalid Role - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                                        pm.test(\"Register Invalid Role - Error code 220\", function () {",
              "                                            const json = res.json();",
              "                                            pm.expect(json.errCode).to.eql(220);",
              "                                        });",
              "                                        // Duplicate Username is not applicable (name not unique) - we test that same name with different email succeeds (should be 201, since name not unique)",
              "                                        pm.sendRequest({",
              "                                            url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                            method: 'POST',",
              "                                            header: { 'Content-Type': 'application/json' },",
              "                                            body: { mode: 'raw', raw: JSON.stringify({ name: pm.collectionVariables.get(\"testName\"), email: \"altname_\" + Date.now() + \"_\" + Math.floor(Math.random()*10000) + \"@example.com\", password: pm.collectionVariables.get(\"testPassword\"), role: \"user\" }) }",
              "                                        }, function (err, res) {",
              "                                            pm.test(\"Register Duplicate Name Allowed - Status code is 201 (name not unique)\", function () { pm.expect(res.code).to.eql(201); });",
              "                                            // Admin Registration Success (201) - for RBAC tests",
              "                                            pm.sendRequest({",
              "                                                url: 'http://localhost:5000/api/anindya/auth/register',",
              "                                                method: 'POST',",
              "                                                header: { 'Content-Type': 'application/json' },",
              "                                                body: { mode: 'raw', raw: JSON.stringify({ name: pm.collectionVariables.get(\"adminName\"), email: pm.collectionVariables.get(\"adminEmail\"), password: pm.collectionVariables.get(\"adminPassword\"), role: \"admin\" }) }",
              "                                            }, function (err, res) {",
              "                                                pm.test(\"Register Admin - Status code is 201 Created\", function () { pm.expect(res.code).to.eql(201); });",
              "                                                pm.test(\"Register Admin - role is admin\", function () {",
              "                                                    const json = res.json();",
              "                                                    pm.expect(json.user.role).to.eql(\"admin\");",
              "                                                    pm.expect(json.user.email).to.eql(pm.collectionVariables.get(\"adminEmail\"));",
              "                                                });",
              "                                                pm.test(\"Register Admin - Save adminId\", function () {",
              "                                                    const json = res.json();",
              "                                                    if (json.user && json.user.id) pm.collectionVariables.set(\"adminId\", json.user.id);",
              "                                                    if (json.token) pm.collectionVariables.set(\"adminTokenTemp\", json.token);",
              "                                                });",
              "                                            });",
              "                                        });",
              "                                    });",
              "                                });",
              "                            });",
              "                        });",
              "                    });",
              "                });",
              "            });",
              "        });",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"{{testRole}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5000/api/anindya/auth/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "anindya",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login - POST /api/anindya/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login - Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Login - Response has Login successful message\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql(\"Login successful\");",
              "    pm.expect(json).to.have.property(\"user\");",
              "    pm.expect(json).to.have.property(\"token\").that.is.a(\"string\").and.not.empty;",
              "    pm.expect(json.user.email).to.eql(pm.collectionVariables.get(\"testEmail\"));",
              "    pm.expect(json.user.name).to.eql(pm.collectionVariables.get(\"testName\"));",
              "    pm.expect(json.user.role).to.eql(\"user\");",
              "    pm.expect(json.user).to.not.have.property(\"password\");",
              "});",
              "pm.test(\"Login - Save token\", function () {",
              "    const json = pm.response.json();",
              "    if (json.token) pm.collectionVariables.set(\"authToken\", json.token);",
              "    if (json.user && json.user.id) pm.collectionVariables.set(\"userId\", json.user.id);",
              "});",
              "",
              "// --- Additional Login Tests ---",
              "// Login Admin Success",
              "pm.sendRequest({",
              "    url: 'http://localhost:5000/api/anindya/auth/login',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get(\"adminEmail\"), password: pm.collectionVariables.get(\"adminPassword\") }) }",
              "}, function (err, res) {",
              "    pm.test(\"Login Admin - Status code is 200\", function () { pm.expect(res.code).to.eql(200); });",
              "    pm.test(\"Login Admin - role is admin\", function () {",
              "        const json = res.json();",
              "        pm.expect(json.user.role).to.eql(\"admin\");",
              "        pm.expect(json.user.email).to.eql(pm.collectionVariables.get(\"adminEmail\"));",
              "        if (json.token) pm.collectionVariables.set(\"adminToken\", json.token);",
              "        if (json.user && json.user.id) pm.collectionVariables.set(\"adminId\", json.user.id);",
              "    });",
              "    // Wrong Case Email (401) - case-sensitive",
              "    pm.sendRequest({",
              "        url: 'http://localhost:5000/api/anindya/auth/login',",
              "        method: 'POST',",
              "        header: { 'Content-Type': 'application/json' },",
              "        body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get(\"testEmailLower\"), password: pm.collectionVariables.get(\"testPassword\") }) }",
              "    }, function (err, res) {",
              "        pm.test(\"Login Wrong Case Email - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "        pm.test(\"Login Wrong Case Email - Error code 233\", function () {",
              "            const json = res.json();",
              "            pm.expect(json.errCode).to.eql(233);",
              "        });",
              "        // Wrong Password (401)",
              "        pm.sendRequest({",
              "            url: 'http://localhost:5000/api/anindya/auth/login',",
              "            method: 'POST',",
              "            header: { 'Content-Type': 'application/json' },",
              "            body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get(\"testEmail\"), password: \"WrongPassword123!\" }) }",
              "        }, function (err, res) {",
              "            pm.test(\"Login Wrong Password - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "            pm.test(\"Login Wrong Password - Error code 233\", function () {",
              "                const json = res.json();",
              "                pm.expect(json.errCode).to.eql(233);",
              "            });",
              "            // Missing Email (400)",
              "            pm.sendRequest({",
              "                url: 'http://localhost:5000/api/anindya/auth/login',",
              "                method: 'POST',",
              "                header: { 'Content-Type': 'application/json' },",
              "                body: { mode: 'raw', raw: JSON.stringify({ password: pm.collectionVariables.get(\"testPassword\") }) }",
              "            }, function (err, res) {",
              "                pm.test(\"Login Missing Email - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                pm.test(\"Login Missing Email - Error code 231\", function () {",
              "                    const json = res.json();",
              "                    pm.expect(json.errCode).to.eql(231);",
              "                });",
              "                // Missing Password (400)",
              "                pm.sendRequest({",
              "                    url: 'http://localhost:5000/api/anindya/auth/login',",
              "                    method: 'POST',",
              "                    header: { 'Content-Type': 'application/json' },",
              "                    body: { mode: 'raw', raw: JSON.stringify({ email: pm.collectionVariables.get(\"testEmail\") }) }",
              "                }, function (err, res) {",
              "                    pm.test(\"Login Missing Password - Status code is 400\", function () { pm.expect(res.code).to.eql(400); });",
              "                    pm.test(\"Login Missing Password - Error code 232\", function () {",
              "                        const json = res.json();",
              "                        pm.expect(json.errCode).to.eql(232);",
              "                    });",
              "                    // Non-existent User (401)",
              "                    pm.sendRequest({",
              "                        url: 'http://localhost:5000/api/anindya/auth/login',",
              "                        method: 'POST',",
              "                        header: { 'Content-Type': 'application/json' },",
              "                        body: { mode: 'raw', raw: JSON.stringify({ email: \"nonexistent_\" + Math.floor(Math.random()*100000) + \"@example.com\", password: \"Password123!\" }) }",
              "                    }, function (err, res) {",
              "                        pm.test(\"Login Non-existent User - Status code is 401\", function () { pm.expect(res.code).to.eql(401); });",
              "                        pm.test(\"Login Non-existent User - Error code 233\", function () {",
              "                            const json = res.json();",
              "                            pm.expect(json.errCode).to.eql(233);",
              "                        });",
              "                    });",
              "                });",
              "            });",
              "        });",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5000/api/anindya/auth/login",
          "protocol": "http",
