          "script": {
            "exec": [
              "let id = pm.collectionVariables.get(\"postId\");",
              "",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has the same post id\", () => {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(Number(pm.response.json().id)).to.eql(id);",
              "});"
